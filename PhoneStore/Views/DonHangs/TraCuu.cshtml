@{ ViewData["Title"] = "Tra cứu đơn hàng"; }
<div class="container py-5" style="max-width:650px"><h2>Tra cứu đơn hàng</h2><p>Nhập mã đơn hàng và số điện thoại đã dùng khi đặt hàng.</p><div asp-validation-summary="All" class="text-danger"></div>
@if(TempData["ThongBao"] != null){<div class="alert alert-success">@TempData["ThongBao"]</div>}@if(TempData["Loi"] != null){<div class="alert alert-danger">@TempData["Loi"]</div>}
<form asp-action="TraCuu" method="post" class="card card-body"><div class="mb-3"><label class="form-label">Mã đơn hàng</label><input name="maDon" class="form-control" required/></div><div class="mb-3"><label class="form-label">Số điện thoại</label><input name="soDienThoai" class="form-control" required/></div><button class="btn btn-danger">Tra cứu</button></form></div>
