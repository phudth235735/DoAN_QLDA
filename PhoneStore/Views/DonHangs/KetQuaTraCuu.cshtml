@model PhoneStore.Models.DonHang
@{ ViewData["Title"] = "Thông tin đơn hàng"; var trangThai = Model.Trangthai switch { 0 => "Chờ xác nhận", 1 => "Đã xác nhận", 2 => "Đang giao hàng", 3 => "Hoàn thành", 4 => "Đã hủy", _ => "Không xác định" }; }
<div class="container py-4"><h2>Thông tin đơn hàng</h2><div class="card card-body"><div class="row"><div class="col-md-6"><p>Mã đơn: <b>@Model.Madonhang</b></p><p>Ngày đặt: @Model.Ngaydat.ToString("dd/MM/yyyy HH:mm")</p><p>Người nhận: @Model.Tennguoinhan</p><p>Điện thoại: @Model.Sdtnguoinhan</p><p>Địa chỉ: @Model.Diachigiaohang</p></div><div class="col-md-6"><p>Trạng thái: <b class="text-danger">@trangThai</b></p><p>Thanh toán: @Model.Phuongthucthanhtoan</p><h4 class="text-danger">@Model.Tongtien.ToString("N0") đ</h4></div></div>
<table class="table"><thead><tr><th>Sản phẩm</th><th>Số lượng</th><th>Đơn giá</th></tr></thead><tbody>@foreach(var ct in Model.ChiTietDonHangs){<tr><td>@ct.Bienthe.Sanpham.Tensanpham (@ct.Bienthe.Dungluong - @ct.Bienthe.Mausac)</td><td>@ct.Soluong</td><td>@ct.Dongia.ToString("N0") đ</td></tr>}</tbody></table>
@if(Model.Trangthai == 0){<form asp-action="Huy" method="post" onsubmit="return confirm('Bạn chắc chắn muốn hủy đơn hàng?')"><input type="hidden" name="id" value="@Model.Donhangid"/><input type="hidden" name="soDienThoai" value="@Model.Sdtnguoinhan"/><button class="btn btn-outline-danger">Hủy đơn hàng</button></form>}</div><a asp-action="TraCuu" class="btn btn-link mt-3">Tra cứu đơn khác</a></div>
