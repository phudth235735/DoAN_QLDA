@model IEnumerable<PhoneStore.Models.SanPham>
@{ ViewData["Title"] = "Cửa hàng điện thoại"; }
<div class="container py-3">
    <h2 class="fw-bold mb-3">Điện thoại & sản phẩm</h2>
    <form method="get" class="card card-body mb-4">
        <div class="row g-2">
            <div class="col-md-4"><input class="form-control" name="tuKhoa" value="@ViewBag.TuKhoa" placeholder="Tìm theo tên hoặc chip..." /></div>
            <div class="col-md-2"><select class="form-select" name="hangId"><option value="">Tất cả hãng</option>@foreach (var h in ViewBag.Hangs){<option value="@h.Hangid" selected="@(ViewBag.HangId == h.Hangid)">@h.Tenhang</option>}</select></div>
            <div class="col-md-2"><select class="form-select" name="danhMucId"><option value="">Tất cả danh mục</option>@foreach (var d in ViewBag.DanhMucs){<option value="@d.Danhmucid" selected="@(ViewBag.DanhMucId == d.Danhmucid)">@d.Tendanhmuc</option>}</select></div>
            <div class="col-md-2"><select class="form-select" name="ram"><option value="">Mọi RAM</option>@foreach(var r in new[]{"4GB","6GB","8GB","12GB","16GB"}){<option value="@r" selected="@(ViewBag.Ram == r)">@r</option>}</select></div>
            <div class="col-md-2"><select class="form-select" name="sapXep"><option value="">Mới & nổi bật</option><option value="gia-tang" selected="@(ViewBag.SapXep == "gia-tang")">Giá tăng dần</option><option value="gia-giam" selected="@(ViewBag.SapXep == "gia-giam")">Giá giảm dần</option><option value="xem-nhieu" selected="@(ViewBag.SapXep == "xem-nhieu")">Xem nhiều</option></select></div>
            <div class="col-md-3"><input class="form-control" type="number" name="giaTu" value="@ViewBag.GiaTu" placeholder="Giá từ" /></div>
            <div class="col-md-3"><input class="form-control" type="number" name="giaDen" value="@ViewBag.GiaDen" placeholder="Giá đến" /></div>
            <div class="col-md-3"><button class="btn btn-danger w-100">Lọc sản phẩm</button></div>
            <div class="col-md-3"><a asp-action="Index" class="btn btn-outline-secondary w-100">Xóa bộ lọc</a></div>
        </div>
    </form>
    @if (!Model.Any()) { <div class="alert alert-info">Không tìm thấy sản phẩm phù hợp.</div> }
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-3">
    @foreach (var sp in Model) { var bt = sp.BienTheSanphams.OrderBy(x => x.Giakhuyenmai ?? x.Giaban).FirstOrDefault();
        <div class="col"><div class="card h-100 shadow-sm">
            <a asp-action="Details" asp-route-id="@sp.Sanphamid"><img src="~/images/@sp.Hinhanh" class="card-img-top p-3" style="height:220px;object-fit:contain" onerror="this.src='https://placehold.co/300x220?text=Phone'" /></a>
            <div class="card-body d-flex flex-column"><h6 class="card-title">@sp.Tensanpham</h6><div class="text-muted small mb-2">@sp.Hang?.Tenhang · @sp.Ram</div>
            @if(bt != null){<strong class="text-danger mb-3">@((bt.Giakhuyenmai ?? bt.Giaban).ToString("N0")) đ</strong>}else{<span class="text-muted">Chưa có phiên bản</span>}
            <a asp-action="Details" asp-route-id="@sp.Sanphamid" class="btn btn-outline-danger mt-auto">Xem chi tiết</a></div>
        </div></div>
    }
    </div>
</div>
