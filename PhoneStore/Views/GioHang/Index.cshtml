@model List<PhoneStore.ViewModels.GioHangItem>
@{ ViewData["Title"] = "Giỏ hàng"; var tong = Model.Sum(x => x.ThanhTien); }
<div class="container py-4"><h2 class="fw-bold mb-3">Giỏ hàng của bạn</h2>
@if (TempData["ThongBao"] != null){<div class="alert alert-success">@TempData["ThongBao"]</div>}
@if (TempData["Loi"] != null){<div class="alert alert-danger">@TempData["Loi"]</div>}
@if (!Model.Any()){<div class="alert alert-info">Giỏ hàng đang trống. <a asp-controller="CuaHang" asp-action="Index">Mua sắm ngay</a>.</div>}
else {<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Sản phẩm</th><th>Đơn giá</th><th style="width:170px">Số lượng</th><th>Thành tiền</th><th></th></tr></thead><tbody>
@foreach(var item in Model){<tr><td><div class="d-flex align-items-center gap-3"><img src="~/images/@item.HinhAnh" style="width:75px;height:75px;object-fit:contain"/><div><b>@item.TenSanPham</b><div class="small text-muted">@item.DungLuong - @item.MauSac</div></div></div></td><td>@item.DonGia.ToString("N0") đ</td><td><form asp-action="CapNhat" method="post" class="d-flex gap-1"><input type="hidden" name="bientheid" value="@item.Bientheid"/><input type="number" min="1" max="@item.TonKho" name="soLuong" value="@item.SoLuong" class="form-control"/><button class="btn btn-outline-secondary">Cập nhật</button></form><small class="text-muted">Tồn kho: @item.TonKho</small></td><td class="text-danger fw-bold">@item.ThanhTien.ToString("N0") đ</td><td><form asp-action="Xoa" method="post"><input type="hidden" name="bientheid" value="@item.Bientheid"/><button class="btn btn-sm btn-outline-danger">Xóa</button></form></td></tr>}
</tbody></table></div><div class="d-flex justify-content-between align-items-center"><a asp-controller="CuaHang" asp-action="Index" class="btn btn-outline-secondary">Tiếp tục mua</a><div class="text-end"><h4>Tổng cộng: <span class="text-danger">@tong.ToString("N0") đ</span></h4><a asp-controller="ThanhToan" asp-action="Index" class="btn btn-danger btn-lg">Tiến hành đặt hàng</a></div></div>}
</div>
