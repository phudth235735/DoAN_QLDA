@model IEnumerable<PhoneStore.ViewModels.BaoCaoSanPhamViewModel>
@{ ViewData["Title"] = "Báo cáo doanh thu"; }
<div class="container py-4"><h2 class="mb-3">Báo cáo - thống kê</h2>
<form method="get" class="row g-2 mb-4"><div class="col-md-4"><label class="form-label">Từ ngày</label><input type="date" name="tuNgay" value="@ViewBag.TuNgay" class="form-control"/></div><div class="col-md-4"><label class="form-label">Đến ngày</label><input type="date" name="denNgay" value="@ViewBag.DenNgay" class="form-control"/></div><div class="col-md-4 d-flex align-items-end"><button class="btn btn-danger w-100">Thống kê</button></div></form>
<div class="row g-3 mb-4"><div class="col-md-4"><div class="card card-body"><small class="text-muted">Tổng đơn (không tính đơn hủy)</small><h3>@ViewBag.SoDon</h3></div></div><div class="col-md-4"><div class="card card-body"><small class="text-muted">Đơn đang xử lý</small><h3>@ViewBag.DonChoXuLy</h3></div></div><div class="col-md-4"><div class="card card-body"><small class="text-muted">Doanh thu đơn hoàn thành</small><h3 class="text-danger">@(((decimal)ViewBag.DoanhThu).ToString("N0")) đ</h3></div></div></div>
<h5>Top sản phẩm bán chạy (đơn hoàn thành)</h5><div class="table-responsive"><table class="table table-striped"><thead><tr><th>Sản phẩm</th><th>Số lượng</th><th>Doanh thu</th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.TenSanPham</td><td>@item.SoLuong</td><td>@(((decimal)item.DoanhThu).ToString("N0")) đ</td></tr>}</tbody></table></div>
<p class="text-muted small">Báo cáo tính doanh thu từ đơn có trạng thái hoàn thành. Trang này hiện chưa được giới hạn quyền quản trị; cần tích hợp phân quyền trước khi triển khai thực tế.</p></div>
