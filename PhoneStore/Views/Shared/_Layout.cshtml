<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HQKStore | Điện thoại, Laptop, Phụ kiện chính hãng</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/HQK.css" asp-append-version="true" />
</head>
<body>
    <!-- Top Banner Cam Kết -->
    <div class="cps-topbar d-none d-md-block">
        <div class="container d-flex justify-content-between align-items-center">
            <span><i class="fa-solid fa-shield-halved me-1"></i> Sản phẩm Chính hãng - Xuất VAT đầy đủ</span>
            <span><i class="fa-solid fa-truck-fast me-1"></i> Giao nhanh - Miễn phí cho đơn 300k</span>
            <span><i class="fa-solid fa-rotate me-1"></i> Thu cũ giá ngon - Lên đời tiết kiệm đến 6 triệu</span>
        </div>
    </div>

    <!-- Header Đỏ Chủ Đạo -->
    <header class="cps-header py-2">
        <div class="container">
            <div class="d-flex align-items-center justify-content-between gap-2 gap-lg-3">
                <!-- Logo -->
                <a class="cps-logo d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    HQK<span class="bg-white text-danger px-1 rounded ms-1" style="font-size: 20px;">Store</span>
                </a>

                <!-- Nút Danh mục -->
                <a class="cps-header-btn d-none d-lg-inline-flex" asp-controller="CuaHang" asp-action="Index">
                    <i class="fa-solid fa-bars fs-5"></i>
                    <span>Danh mục</span>
                </a>

                <!-- Khu vực xem giá -->
                <div class="dropdown d-none d-xl-block">
                    <button class="cps-header-btn dropdown-toggle" type="button" data-bs-toggle="dropdown">
                        <i class="fa-solid fa-location-dot fs-5"></i>
                        <div class="text-start">
                            <div style="font-size: 11px; opacity: 0.9;">Xem giá tại</div>
                            <div class="fw-bold">Hồ Chí Minh</div>
                        </div>
                    </button>
                    <ul class="dropdown-menu shadow">
                        <li><a class="dropdown-item" href="#">Hồ Chí Minh</a></li>
                        <li><a class="dropdown-item" href="#">Hà Nội</a></li>
                        <li><a class="dropdown-item" href="#">An Giang</a></li>
                        <li><a class="dropdown-item" href="#">Cần Thơ</a></li>
                    </ul>
                </div>

                <!-- Thanh tìm kiếm -->
                <form class="flex-grow-1" asp-controller="CuaHang" asp-action="Index" method="get">
                    <div class="input-group cps-search-box">
                        <span class="input-group-text bg-white border-0 text-muted">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </span>
                        <input type="text" name="tuKhoa" class="form-control" placeholder="Bạn cần tìm điện thoại gì hôm nay? (iPhone 18, S26 Ultra...)" />
                    </div>
                </form>

                <!-- Hotline & Tra cứu đơn -->
                <a class="cps-header-btn d-none d-md-inline-flex" href="tel:18002097">
                    <i class="fa-solid fa-phone-volume fs-5"></i>
                    <div class="text-start">
                        <div style="font-size: 11px;">Gọi mua hàng</div>
                        <div class="fw-bold">1800.2097</div>
                    </div>
                </a>

                <a class="cps-header-btn d-none d-lg-inline-flex" asp-controller="DonHangs" asp-action="TraCuu">
                    <i class="fa-solid fa-truck-fast fs-5"></i>
                    <div class="text-start">
                        <div>Tra cứu</div>
                        <div class="fw-bold">đơn hàng</div>
                    </div>
                </a>

                <!-- Giỏ hàng -->
                <a class="cps-header-btn position-relative" asp-controller="GioHang" asp-action="Index">
                    <i class="fa-solid fa-bag-shopping fs-5"></i>
                    <div class="text-start d-none d-sm-block">
                        <div>Giỏ</div>
                        <div class="fw-bold">hàng</div>
                    </div>
                </a>

                <!-- Tài khoản (Identity) -->
                <partial name="_LoginPartial" />
            </div>
        </div>
    </header>

    <!-- Nội dung chính -->
    <main class="container my-3">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-white border-top mt-5 pt-4 pb-3">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4">
                    <h6 class="fw-bold text-danger">Tổng đài hỗ trợ miễn phí</h6>
                    <p class="mb-1 small">Gọi mua hàng: <strong>1800.2097</strong> (7h30 - 22h00)</p>
                    <p class="mb-1 small">Gọi khiếu nại: <strong>1800.2063</strong> (8h00 - 21h30)</p>
                    <p class="mb-1 small">Gọi bảo hành: <strong>1800.2064</strong> (8h00 - 21h00)</p>
                </div>
                <div class="col-md-4">
                    <h6 class="fw-bold">Thông tin và chính sách</h6>
                    <ul class="list-unstyled small text-muted">
                        <li>Mua hàng và thanh toán Online</li>
                        <li>Mua hàng trả góp Online 0% lãi suất</li>
                        <li>Chính sách bảo hành chính hãng 12 tháng</li>
                        <li>Tra cứu thông tin bảo hành & hóa đơn điện tử</li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6 class="fw-bold">Dịch vụ và thông tin khác</h6>
                    <ul class="list-unstyled small text-muted">
                        <li>Khách hàng doanh nghiệp (B2B)</li>
                        <li>Ưu đãi học sinh - sinh viên S-Student</li>
                        <li>Thu cũ đổi mới - Lên đời trợ giá cao</li>
                    </ul>
                </div>
            </div>
            <div class="text-center text-muted small border-top pt-3 mt-3">
                © 2026 HQKStore - Cửa Hàng Bán Điện Thoại Di Động 
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>