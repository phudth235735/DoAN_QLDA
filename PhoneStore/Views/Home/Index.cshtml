@model IEnumerable<PhoneStore.Models.SanPham>
@using PhoneStore.Models

@{
    ViewData["Title"] = "Trang chủ";
    var dsHang = ViewBag.DanhSachHang as List<HangSanXuat> ?? new List<HangSanXuat>();
    var dsNhuCau = ViewBag.DanhSachNhuCau as List<NhuCau> ?? new List<NhuCau>();
    var dsHotSale = ViewBag.SanPhamHotSale as List<SanPham> ?? new List<SanPham>();
    var dsTin = ViewBag.TinCongNghe as List<TinCongNghe> ?? new List<TinCongNghe>();
}

<!-- 1. KHỐI HERO 3 CỘT -->
<div class="row g-3 mb-4">
    <!-- Cột trái: Danh mục Hãng & Nhu cầu -->
    <div class="col-lg-2 d-none d-lg-block">
        <div class="cps-sidebar-menu h-100">
            @foreach (var hang in dsHang)
            {
                <a asp-action="Index" asp-route-hangId="@hang.Hangid">
                    <span><i class="fa-solid fa-mobile-screen-button text-danger me-2"></i>Điện thoại @hang.Tenhang</span>
                    <i class="fa-solid fa-chevron-right small text-muted"></i>
                </a>
            }
            <hr class="my-1 mx-2" />
            @foreach (var nc in dsNhuCau)
            {
                <a asp-action="Index" asp-route-nhucauId="@nc.Nhucauid">
                    <span><i class="fa-solid fa-bolt text-warning me-2"></i>@nc.Tennhucau</span>
                    <i class="fa-solid fa-chevron-right small text-muted"></i>
                </a>
            }
        </div>
    </div>

    <!-- Cột giữa: Banner Quảng Cáo Đỏ -->
    <div class="col-lg-7">
        <div id="heroCarousel" class="carousel slide rounded-4 overflow-hidden shadow-sm h-100" data-bs-ride="carousel">
            <div class="carousel-inner h-100">
                <div class="carousel-item active h-100">
                    <div class="p-4 p-md-5 text-white h-100 d-flex flex-column justify-content-center"
                         style="background: linear-gradient(135deg, #D70018 0%, #8A000E 100%); min-height: 310px;">
                        <span class="badge bg-warning text-dark w-auto align-self-start mb-2">MỞ BÁN ĐỘC QUYỀN</span>
                        <h2 class="fw-bolder mb-2">IPHONE 18 PRO MAX</h2>
                        <p class="mb-3 opacity-90">Sẵn hàng. Giao liền tay! Thu cũ lên đời trợ giá ngay đến 5 triệu đồng.</p>
                        <a asp-controller="CuaHang" asp-action="Details" asp-route-id="1" class="btn btn-light text-danger fw-bold align-self-start px-4">
                            Mua ngay <i class="fa-solid fa-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
                <div class="carousel-item h-100">
                    <div class="p-4 p-md-5 text-white h-100 d-flex flex-column justify-content-center"
                         style="background: linear-gradient(135deg, #1E293B 0%, #D70018 100%); min-height: 310px;">
                        <span class="badge bg-danger mb-2 align-self-start">QUYỀN NĂNG GALAXY AI</span>
                        <h2 class="fw-bolder mb-2">GALAXY S26 ULTRA 5G</h2>
                        <p class="mb-3 opacity-90">Giảm thẳng đến 9 triệu + Tặng thêm 12 tháng bảo hành Samsung Care+.</p>
                        <a asp-controller="CuaHang" asp-action="Details" asp-route-id="2" class="btn btn-warning fw-bold align-self-start px-4">
                            Xem ưu đãi
                        </a>
                    </div>
                </div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon"></span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon"></span>
            </button>
        </div>
    </div>

    <!-- Cột phải: Thẻ Ưu Đãi Smember & S-Student -->
    <div class="col-lg-3 d-flex flex-column gap-3">
        <div class="bg-white rounded-4 p-3 shadow-sm border border-danger-subtle flex-fill">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge bg-danger rounded-circle p-2"><i class="fa-solid fa-crown"></i></span>
                <h6 class="fw-bold mb-0 text-danger">Chào mừng đến HQKStore</h6>
            </div>
            <p class="small text-muted mb-2">Nhập hội thành viên <strong>Smember</strong> để nhận ưu đãi giảm thêm 1% mọi đơn hàng.</p>
            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-danger btn-sm w-100 fw-bold">Đăng nhập / Đăng ký</a>
        </div>

        <div class="rounded-4 p-3 text-white shadow-sm flex-fill" style="background: linear-gradient(135deg, #FF512F, #DD2476);">
            <span class="badge bg-white text-danger mb-1">S-STUDENT</span>
            <h6 class="fw-bold mb-1">Ưu đãi Học sinh - Sinh viên</h6>
            <p class="small mb-0 opacity-90">Giảm thêm đến 500.000đ khi mua điện thoại, laptop tựu trường.</p>
        </div>
    </div>
</div>

<!-- 2. HOT SALE CUỐI TUẦN -->
@if (dsHotSale.Any())
{
    <section class="cps-hotsale-box mb-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
            <h4 class="text-white fw-bolder mb-0">
                <i class="fa-solid fa-fire text-warning me-2"></i>HOT SALE CUỐI TUẦN
            </h4>
            <div class="d-flex align-items-center gap-2 text-white fw-bold small">
                <span>Kết thúc sau:</span>
                <span class="countdown-badge" id="cd-hours">12</span> :
                <span class="countdown-badge" id="cd-mins">45</span> :
                <span class="countdown-badge" id="cd-secs">30</span>
            </div>
        </div>

        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-5 g-3">
            @foreach (var sp in dsHotSale)
            {
                var bt = sp.BienTheSanphams.FirstOrDefault();
                decimal giaBan = bt?.Giaban ?? 0;
                decimal giaKm = bt?.Giakhuyenmai ?? giaBan;
                int phanTramGiam = giaBan > 0 ? (int)Math.Round((giaBan - giaKm) / giaBan * 100) : 0;

                <div class="col">
                    <div class="cps-product-card">
                        @if (phanTramGiam > 0)
                        {
                            <span class="cps-discount-ribbon">Giảm @phanTramGiam%</span>
                        }
                        @if (sp.Tragop0)
                        {
                            <span class="cps-installment-badge">Trả góp 0%</span>
                        }

                        <a asp-controller="CuaHang" asp-action="Details" asp-route-id="@sp.Sanphamid" class="text-center">
                            <img src="~/images/@sp.Hinhanh"
                                 onerror="this.src='https://placehold.co/300x300/fff0f1/d70018?text=@Uri.EscapeDataString(sp.Tensanpham)'"
                                 alt="@sp.Tensanpham" class="cps-product-img img-fluid" />
                        </a>

                        <div>
                            <a asp-controller="CuaHang" asp-action="Details" asp-route-id="@sp.Sanphamid" class="cps-product-title mb-2">
                                @sp.Tensanpham
                            </a>

                            <div class="d-flex align-items-baseline gap-2 flex-wrap">
                                <span class="cps-price-sale">@giaKm.ToString("N0")đ</span>
                                @if (giaKm < giaBan)
                                {
                                    <span class="cps-price-old">@giaBan.ToString("N0")đ</span>
                                }
                            </div>

                            <div class="cps-promo-note">
                                Trợ giá thu cũ lên đến <strong>@sp.Trogiathucu.ToString("N0")đ</strong>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
}

<!-- 3. DANH SÁCH ĐIỆN THOẠI NỔI BẬT + LỌC HÃNG -->
<section class="mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h4 class="fw-bolder text-uppercase mb-0">
            <span class="border-start border-4 border-danger ps-2">Điện thoại nổi bật nhất</span>
        </h4>

        <!-- Bộ lọc nhanh theo Hãng -->
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Index" class="cps-filter-pill @(ViewBag.HangDangChon == null ? "active" : "")">Tất cả</a>
            @foreach (var hang in dsHang)
            {
                <a asp-action="Index" asp-route-hangId="@hang.Hangid"
                   class="cps-filter-pill @(ViewBag.HangDangChon == hang.Hangid ? "active" : "")">
                    @hang.Tenhang
                </a>
            }
        </div>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-5 g-3">
        @foreach (var sp in Model)
        {
            var bt = sp.BienTheSanphams.FirstOrDefault();
            decimal giaBan = bt?.Giaban ?? 0;
            decimal giaKm = bt?.Giakhuyenmai ?? giaBan;
            int phanTramGiam = giaBan > 0 ? (int)Math.Round((giaBan - giaKm) / giaBan * 100) : 0;

            <div class="col">
                <div class="cps-product-card">
                    @if (phanTramGiam > 0)
                    {
                        <span class="cps-discount-ribbon">Giảm @phanTramGiam%</span>
                    }
                    @if (sp.Tragop0)
                    {
                        <span class="cps-installment-badge">Trả góp 0%</span>
                    }

                    <a asp-controller="CuaHang" asp-action="Details" asp-route-id="@sp.Sanphamid" class="text-center">
                        <img src="~/images/@sp.Hinhanh"
                             onerror="this.src='https://placehold.co/300x300/fff0f1/d70018?text=@Uri.EscapeDataString(sp.Tensanpham)'"
                             alt="@sp.Tensanpham" class="cps-product-img img-fluid" />
                    </a>

                    <div>
                        <a asp-controller="CuaHang" asp-action="Details" asp-route-id="@sp.Sanphamid" class="cps-product-title mb-1">
                            @sp.Tensanpham
                        </a>

                        <!-- Chip thông số tóm tắt -->
                        <div class="d-flex gap-1 mb-2 flex-wrap">
                            @if (!string.IsNullOrEmpty(sp.Manhinh))
                            {
                                <span class="badge bg-light text-dark border">@sp.Manhinh.Split(' ')[0] inch</span>
                            }
                            @if (!string.IsNullOrEmpty(sp.Ram))
                            {
                                <span class="badge bg-light text-dark border">@sp.Ram</span>
                            }
                            @if (bt != null)
                            {
                                <span class="badge bg-light text-dark border">@bt.Dungluong</span>
                            }
                        </div>

                        <div class="d-flex align-items-baseline gap-2 flex-wrap">
                            <span class="cps-price-sale">@giaKm.ToString("N0")đ</span>
                            @if (giaKm < giaBan)
                            {
                                <span class="cps-price-old">@giaBan.ToString("N0")đ</span>
                            }
                        </div>

                        <div class="cps-promo-note">
                            Smember giảm thêm đến <strong>@((giaKm * 0.01m).ToString("N0"))đ</strong>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-2 pt-1">
                            <div class="text-warning small">
                                <i class="fa-solid fa-star"></i>
                                <i class="fa-solid fa-star"></i>
                                <i class="fa-solid fa-star"></i>
                                <i class="fa-solid fa-star"></i>
                                <i class="fa-solid fa-star"></i>
                            </div>
                            <a asp-controller="CuaHang" asp-action="Details" asp-route-id="@sp.Sanphamid"
                               class="btn btn-outline-danger btn-sm py-0 px-2 fw-semibold">
                                Chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<!-- 4. TIN CÔNG NGHỆ SFORUM -->
@if (dsTin.Any())
{
    <section class="bg-white rounded-4 p-3 p-md-4 shadow-sm">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bolder text-uppercase mb-0">
                <span class="border-start border-4 border-danger ps-2">Tin công nghệ Sforum</span>
            </h5>
            <a asp-controller="TinCongNghes" asp-action="Index" class="text-danger text-decoration-none fw-semibold small">
                Xem tất cả <i class="fa-solid fa-chevron-right"></i>
            </a>
        </div>

        <div class="row g-3">
            @foreach (var tin in dsTin)
            {
                <div class="col-md-6">
                    <div class="d-flex gap-3 align-items-center border rounded-3 p-2 h-100">
                        <img src="~/images/@tin.Hinhanh"
                             onerror="this.src='https://placehold.co/160x100/d70018/ffffff?text=Sforum'"
                             class="rounded-3" style="width: 140px; height: 90px; object-fit: cover;" alt="@tin.Tieude" />
                        <div>
                            <h6 class="fw-bold mb-1" style="font-size: 14px;">@tin.Tieude</h6>
                            <p class="text-muted small mb-0 text-truncate" style="max-width: 320px;">@tin.Tomtat</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
}

@section Scripts {
    <script>
        // Đồng hồ đếm ngược Hot Sale
        let totalSeconds = 12 * 3600 + 45 * 60 + 30;
        setInterval(() => {
            if (totalSeconds <= 0) return;
            totalSeconds--;
            const h = String(Math.floor(totalSeconds / 3600)).padStart(2, '0');
            const m = String(Math.floor((totalSeconds % 3600) / 60)).padStart(2, '0');
            const s = String(totalSeconds % 60).padStart(2, '0');
            document.getElementById('cd-hours').innerText = h;
            document.getElementById('cd-mins').innerText = m;
            document.getElementById('cd-secs').innerText = s;
        }, 1000);
    </script>
}